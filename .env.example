# FARIA runtime environment — RF-01 (Hermes / 9Router / Telegram connectivity only)
#
# Copy this file to `.env` in the repository root and fill in real values
# locally. `.env` is gitignored — never commit it or paste real values here.
#
# See docs/05_operations/CONFIGURATION.md for what each variable means and
# scripts/runtime/README.md for how they're verified.

# --- Hermes image ------------------------------------------------------------
# No public prebuilt Hermes Agent image exists (verified 2026-09-11). Build
# one locally from https://github.com/NousResearch/hermes-agent and set the
# resulting tag here (see docs/05_operations/DEVELOPER_SETUP.md).
HERMES_IMAGE=hermes-agent:local

# --- 9Router (model gateway) -------------------------------------------------
# Base URL of your running 9Router instance, as reachable FROM the Hermes
# container. On Docker Desktop (Windows/macOS) and on Linux (via the
# extra_hosts entry in infra/docker/compose.yaml), host.docker.internal
# reaches services running on your developer host.
# Verify the actual port/path against your own 9Router instance — this is a
# commonly expected development default, not a guarantee.
ROUTER9_BASE_URL=http://host.docker.internal:20128/v1

# 9Router's own API key/credential. Hermes always names this variable
# OPENAI_API_KEY for any custom OpenAI-compatible provider — this is NOT an
# OpenRouter key and NOT a subscription token; see AGENTS.md guardrails.
OPENAI_API_KEY=changeme-9router-key

# --- Telegram gateway ---------------------------------------------------------
# Bot token issued by https://t.me/BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=changeme-telegram-bot-token

# Comma-separated numeric Telegram user IDs for the two allowlisted household
# members (PRD PR-004). FARIA must not process messages from any other
# identity. Do not set an "allow all" equivalent.
TELEGRAM_ALLOWED_USERS=111111111,222222222
